{
  "version": 6,
  "configurePresets": [
    {
      "name": "cpu",
      "displayName": "ggml on the CPU only (Metal device probing on macOS)",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/cpu",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "SHARDLINE_WERROR": "ON",
        "SHARDLINE_GGML_METAL": "OFF"
      }
    },
    {
      "name": "metal",
      "displayName": "ggml on the CPU and the Apple GPU",
      "inherits": "cpu",
      "binaryDir": "${sourceDir}/build/metal",
      "cacheVariables": {
        "SHARDLINE_GGML_METAL": "ON"
      },
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Darwin" }
    },
    {
      "name": "cuda",
      "displayName": "With CUDA device probing",
      "inherits": "cpu",
      "binaryDir": "${sourceDir}/build/cuda",
      "cacheVariables": {
        "SHARDLINE_CUDA": "ON"
      }
    }
  ],
  "buildPresets": [
    { "name": "cpu", "configurePreset": "cpu" },
    { "name": "metal", "configurePreset": "metal" },
    { "name": "cuda", "configurePreset": "cuda" }
  ],
  "testPresets": [
    {
      "name": "cpu",
      "configurePreset": "cpu",
      "output": { "outputOnFailure": true }
    },
    {
      "name": "metal",
      "configurePreset": "metal",
      "output": { "outputOnFailure": true }
    },
    {
      "name": "cuda",
      "configurePreset": "cuda",
      "output": { "outputOnFailure": true }
    }
  ]
}
